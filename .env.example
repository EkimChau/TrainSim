PORT=3000
# Keep 127.0.0.1: the app has no sign-in or permissions by design and rejects non-loopback API clients.
HOST=127.0.0.1
# Google Maps JavaScript API browser key. Leave empty to use OpenStreetMap tiles instead.
# Restrict it to the Maps JavaScript API and the referrers http://127.0.0.1:3000/* and http://localhost:3000/*.
GOOGLE_MAPS_API_KEY=
# Optional vector Map ID (Google Cloud > Map Management). Enables deck.gl interleaved rendering
# so railway lines draw beneath Google's labels.
GOOGLE_MAPS_MAP_ID=
# World database the map uses (relative to the project root).
TRAINSIM_DB=data/trainsim.sqlite
