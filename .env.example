# Leave unset to run the completely local SVG-based demo.
PORT=3000
HOST=127.0.0.1
# Google Maps JavaScript API browser key. Restrict to Maps JavaScript API and allowed referrers.
GOOGLE_MAPS_API_KEY=
# Google Identity Services Web OAuth client ID. Separate from the Maps API key.
GIS_CLIENT_ID=
# Required if GIS_CLIENT_ID is set (at least 32 random characters).
SESSION_SECRET=
# Set to 1 only behind HTTPS in production to mark auth cookies Secure.
COOKIE_SECURE=0
