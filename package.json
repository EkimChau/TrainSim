{
  "name": "trainsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrainSim: OpenRailwayMap/OSM railway world database, ORM-style map on Google Maps, live database editor and simulator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run ingest:docs && bun build ./src/client/app.js --target browser --format esm --minify --sourcemap=linked --outdir ./public/assets --entry-naming app.[ext]",
    "ingest:docs": "node scripts/docs/ingest.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch ./server/index.js",
    "start": "node --env-file-if-exists=.env ./server/index.js",
    "test": "node --test tests/*.test.js && npm run test:py",
    "test:js": "node --test tests/*.test.js",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm test && npm run build",
    "ingest": "python3 scripts/ingest_osm.py",
    "ingest:translink": "python3 scripts/ingest_translink_gtfs.py",
    "ingest:caboolture": "python3 scripts/ingest_osm.py --lines \"Caboolture Line\"",
    "ingest:geofabrik": "python3 scripts/ingest_osm.py --source geofabrik",
    "ingest:fixture": "python3 scripts/ingest_osm.py --source file data/fixtures/osm-seq-fixture.osm",
    "ingest:etcs": "python3 scripts/esig/ingest.py",
    "check:etcs": "python3 scripts/esig/verify.py",
    "test:esig": "python3 -m unittest discover -s tests -p test_esig_ingest.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/google-maps": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "codemirror": "^6.0.2",
    "express": "^5.1.0",
    "tabulator-tables": "^6.3.0"
  }
}
