{
  "name": "trainsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrainSim Express prototype and modular simulation seed",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build ./src/client/main.js --target browser --format esm --outfile ./public/assets/app.js && bun build ./src/client/db-admin.js --target browser --format esm --outdir ./public/assets",
    "dev": "npm run build && node --env-file-if-exists=.env --watch ./server/index.js",
    "start": "node --env-file-if-exists=.env ./server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "preview": "node ./scripts/preview.mjs",
    "ingest:osm": "python3 scripts/ingest_osm.py --download",
    "check:region": "python3 -m unittest discover -s tests -p test_rail_ingest.py",
    "ingest:etcs": "python3 scripts/esig/ingest.py",
    "check:etcs": "python3 scripts/esig/verify.py",
    "test:esig": "python3 -m unittest discover -s tests -p test_esig_ingest.py"
  },
  "dependencies": {
    "express": "^5.1.0",
    "google-auth-library": "^10.3.0",
    "codemirror": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "tabulator-tables": "^6.3.0"
  }
}
