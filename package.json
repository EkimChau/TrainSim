{
  "name": "trainsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrainSim Express prototype and modular simulation seed",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build ./src/client/main.js --target browser --format esm --outfile ./public/assets/app.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch ./server/index.js",
    "start": "node --env-file-if-exists=.env ./server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "preview": "node ./scripts/preview.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "google-auth-library": "^10.3.0"
  }
}
