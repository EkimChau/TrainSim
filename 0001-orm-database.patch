+    for n in stations:
+        k=n.casefold()
+        if k not in stop_map:stop_map[k]={'name':n,'modes':[],'lines':[],'source':'diagram-manual-transcription','wgs84':None,'osm_id':None,'match_status':'unverified'}
+        if mode not in stop_map[k]['modes']:stop_map[k]['modes'].append(mode)
