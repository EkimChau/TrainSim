+// The only Google Maps dependency boundary. Can be swapped without touching the sim engine.
+export async function loadGoogleMaps(apiKey) {
+  if(!apiKey)return null;
+  return new Promise((resolve,reject)=>{
+    const callback=`__trainsimMapReady_${Date.now()}`;
+    const timeout=setTimeout(()=>{cleanup();reject(new Error('Google Maps load timeout'));},10000);
+    const script=document.createElement('script');
+    const cleanup=()=>{clearTimeout(timeout);delete window[callback];};
+    window[callback]=()=>{cleanup();resolve(window.google?.maps||null);};
+    script.onerror=()=>{cleanup();reject(new Error('Google Maps script unavailable'));};
+    script.src=`https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&v=weekly&callback=${callback}`;
+    script.async=true;document.head.append(script);
+  });
+}
+export class GoogleMapsAdaptor {
+  constructor(container,maps,center) {
+    this.name='Google Maps';this.maps=maps;
+    this.map=new maps.Map(container,{center,zoom:12,streetViewControl:false,fullscreenControl:true});
+  }
+  fitWorld(world) {
+    const points=world.stations;
+    if(!points.length)return;
+    const bounds=new this.maps.LatLngBounds();
+    for(const p of points)bounds.extend({lat:p.lat,lng:p.lng});
+    this.map.fitBounds(bounds,48);
+  }
+  addTrack(track){const line=new this.maps.Polyline({path:track.coords,geodesic:true,strokeColor:'#e96260',strokeOpacity:.90,strokeWeight:track.source==='OSM'?3:4,map:this.map});return{setVisible:on=>line.setMap(on?this.map:null),remove:()=>line.setMap(null)};}
+  addPoint(kind,record){
+    const icon=kind==='station'?{path:this.maps.SymbolPath.CIRCLE,scale:7,fillColor:'#77b4ff',fillOpacity:1,strokeColor:'#fff',strokeWeight:2}:kind==='signal'?{path:'M 0 -9 L 9 8 L -9 8 Z',scale:1,fillColor:'#52e1a3',fillOpacity:1,strokeColor:'#071e14',strokeWeight:2}:{path:this.maps.SymbolPath.FORWARD_CLOSED_ARROW,scale:6,fillColor:record.color||'#ffdb52',fillOpacity:1,strokeColor:'#10151d',strokeWeight:2};
+    const marker=new this.maps.Marker({map:this.map,position:record.position||record,title:record.name||record.id,icon});
+    return{setVisible:on=>marker.setMap(on?this.map:null),remove:()=>marker.setMap(null),setPosition:p=>marker.setPosition(p),setAlert:alert=>{marker.setIcon({...icon,fillColor:alert?'#ff4f60':record.color||'#ffdb52'});}};
+  }
+}
diff --git a/src/client/adapters/svg.js b/src/client/adapters/svg.js
new file mode 100644
index 0000000..5df9755
--- /dev/null
+++ b/src/client/adapters/svg.js
@@ -0,0 +1,34 @@
+// Local SVG renderer: a working zero-credential demo, not a geographical basemap.
+const NS='http://www.w3.org/2000/svg';
+const make=(name,attributes={})=>{const el=document.createElementNS(NS,name);for(const [k,v] of Object.entries(attributes))el.setAttribute(k,String(v));return el;};
+export class SvgAdaptor {
+  constructor(container,world) {
+    this.container=container;this.name='SVG demo canvas';
+    const coords=[...world.tracks.flatMap(t=>t.coords),...world.stations];
+    this.bounds={minLat:Math.min(...coords.map(p=>p.lat))-.008,maxLat:Math.max(...coords.map(p=>p.lat))+.008,minLng:Math.min(...coords.map(p=>p.lng))-.012,maxLng:Math.max(...coords.map(p=>p.lng))+.012};
+    this.svg=make('svg',{viewBox:'0 0 1000 680',role:'img','aria-label':'Schematic Brisbane synthetic rail demo','preserveAspectRatio':'xMidYMid meet'});
+    this.svg.classList.add('demo-svg');
+    this.svg.append(make('rect',{width:1000,height:680,fill:'#101e2d'}));
+    // Visual grid; no claim of map accuracy.
+    for(let i=0;i<10;i++)this.svg.append(make('path',{d:`M ${i*120} 0 V 680 M 0 ${i*90} H 1000`,stroke:'#27384a','stroke-width':1}));
+    const north=make('text',{x:950,y:46,fill:'#93aec4','font-size':16});north.textContent='N ↑';this.svg.append(north);
+    container.replaceChildren(this.svg);
+  }
+  xy(pos) {const {minLat,maxLat,minLng,maxLng}=this.bounds;return {x:50+(pos.lng-minLng)/(maxLng-minLng)*900,y:40+(maxLat-pos.lat)/(maxLat-minLat)*600};}
+  addTrack(track) {
+    const el=make('polyline',{points:track.coords.map(c=>{const p=this.xy(c);return `${p.x},${p.y}`}).join(' '),fill:'none',stroke:'#e96260','stroke-width':track.source==='OSM'?3:4,'stroke-linejoin':'round','stroke-linecap':'round'});
+    this.svg.append(el);return this.control(el);
+  }
+  addPoint(kind,record) {
+    const pos=record.position||record,point=this.xy(pos);
+    const grp=make('g',{transform:`translate(${point.x} ${point.y})`});
+    if(kind==='station'){
+      grp.append(make('circle',{r:7,fill:'#77b4ff',stroke:'#ecf6ff','stroke-width':2}));
+      const label=make('text',{x:11,y:-10,fill:'#bed4eb','font-size':12,'paint-order':'stroke',stroke:'#101e2d','stroke-width':4});label.textContent=record.name;grp.append(label);
+    } else if(kind==='signal')grp.append(make('path',{d:'M 0 -9 L 9 8 L -9 8 Z',fill:'#52e1a3',stroke:'#0b2119','stroke-width':2}));
+    else grp.append(make('path',{d:'M 0 -11 L 8 10 L 0 6 L -8 10 Z',fill:record.color||'#ffdb52',stroke:'#131722','stroke-width':2}));
+    const title=make('title');title.textContent=record.name||record.id||kind;grp.append(title);this.svg.append(grp);
+    return {...this.control(grp),setPosition:p=>{const pt=this.xy(p);grp.setAttribute('transform',`translate(${pt.x} ${pt.y})`);},setAlert:alert=>{if(kind==='train')grp.querySelector('path').setAttribute('fill',alert?'#ff4f60':record.color||'#ffdb52');}};
+  }
+  control(el) {return {setVisible:on=>el.style.display=on?'':'none',remove:()=>el.remove()};}
+}
diff --git a/src/client/main.js b/src/client/main.js
new file mode 100644
index 0000000..0687cc7
--- /dev/null
+++ b/src/client/main.js
@@ -0,0 +1,108 @@
+import {SEED_WORLD} from '../shared/seed-world.js';
+import {SimWorld} from '../shared/simworld.js';
+import {compileDemoInstruments} from '../shared/simspec.js';
+import {SCENES,createScene} from '../shared/simscene.js';
+import {SimRun} from '../shared/simrun.js';
+import {SvgAdaptor} from './adapters/svg.js';
+import {GoogleMapsAdaptor,loadGoogleMaps} from './adapters/google.js';
+
+const $=id=>document.getElementById(id);
+const state={world:new SimWorld(SEED_WORLD),adapter:null,objects:{tracks:[],stations:[],signals:[],trains:[]},timer:null,runner:null,compiled:false};
+function log(message,level='info') {
+  const p=document.createElement('p');p.className=`log-${level}`;
+  p.textContent=`[${new Date().toLocaleTimeString()}] ${message}`;
+  $('telemetry-log').prepend(p);
+  while($('telemetry-log').children.length>120)$('telemetry-log').lastChild.remove();
+}
+function clear(type){for(const item of state.objects[type])item.remove();state.objects[type]=[];}
+function setStatus(text,running=false){$('status-text').textContent=text;$('sim-status-overlay').classList.toggle('status-active',running);}
+function layerChange(){for(const type of ['tracks','stations','signals'])for(const item of state.objects[type])item.setVisible($(`layer-${type}`).checked);}
+function compile() {
+  stop(false);for(const type of ['tracks','stations','signals'])clear(type);
+  const real=state.world.source==='OSM-derived';
+  const result=real?{devices:state.world.signals.map(s=>({id:s.id,position:{lat:s.lat,lng:s.lng},provenance:'OSM'}))}:compileDemoInstruments(state.world);
+  state.objects.tracks=state.world.tracks.map(t=>state.adapter.addTrack(t));
+  state.objects.stations=state.world.stations.map(s=>state.adapter.addPoint('station',s));
+  state.objects.signals=result.devices.map(d=>state.adapter.addPoint('signal',{...d,position:d.position}));
+  state.compiled=true;$('btn-play-sim').disabled=!$('scenario-selector').options.length;layerChange();
+  if(real&&state.adapter.fitWorld)state.adapter.fitWorld(state.world);
+  if(real){
+    setStatus('OSM snapshot · mapped infrastructure');
+    log(`OSM: ${state.world.tracks.length} source railway ways, ${state.world.stations.length} mapped stations, ${result.devices.length} OSM signals.`, 'ok');
+    log('Visual route trace only; track/signal rules and station stop order NOT safety verified.', 'warn');
+    if(!state.world.routes.length)log('No complete connected service routes. Playback disabled; inspect unresolved station matches.', 'warn');
+  }else{
+    setStatus('Infrastructure compiled · demo heuristic');
+    log(`SimSpec: ${state.world.tracks.length} synthetic tracks, ${state.world.stations.length} stations, ${result.devices.length} illustrative balises.`, 'ok');
+    log('NOT validated against live ORM or engineering regulations.', 'warn');
+  }
+}
+function updateTick() {
+  const {events,trains}=state.runner.step();
+  trains.forEach((train,i)=>{state.objects.trains[i].setPosition(train.position);state.objects.trains[i].setAlert(train.alert);});
+  // Keep logging light; warn every tick but position logs at intervals.
+  if(state.runner.tick%8===0||events.some(e=>e.type==='demo-warning'))for(const event of events)log(event.message,event.type==='demo-warning'?'warn':'info');
+}
+function start() {
+  if(!state.compiled||state.timer)return;
+  const scene=createScene($('scenario-selector').value,state.world);state.runner=new SimRun(scene);
+  clear('trains');state.objects.trains=scene.trains.map(t=>state.adapter.addPoint('train',t));
+  $('btn-play-sim').hidden=true;$('btn-stop-sim').hidden=false;$('btn-compile').disabled=true;$('scenario-selector').disabled=true;
+  setStatus(`Running · ${scene.id}`,true);log(`SimRun started: ${scene.id}`,'ok');
+  state.timer=setInterval(updateTick,300);
+}
+function stop(notify=true) {
+  if(state.timer)clearInterval(state.timer);state.timer=null;state.runner=null;clear('trains');
+  $('btn-play-sim').hidden=false;$('btn-stop-sim').hidden=true;$('btn-compile').disabled=false;$('scenario-selector').disabled=false;
+  if(notify){setStatus(state.compiled?'Compiled · idle':'Idle');log('SimRun stopped.');}
+}
+const loadScript=url=>new Promise((resolve,reject)=>{const el=document.createElement('script');el.src=url;el.async=true;el.onload=resolve;el.onerror=reject;document.head.append(el);});
+async function initGIS(clientId) {
+  const auth=$('auth-area');if(!clientId){auth.textContent='Guest demo · GIS not configured';return;}
+  try {
+    const me=await fetch('/api/auth/me').then(r=>r.json());
+    if(me.user){renderUser(me.user);return;}
+    await loadScript('https://accounts.google.com/gsi/client');
+    window.google.accounts.id.initialize({client_id:clientId,callback:async ({credential})=>{
+      const res=await fetch('/api/auth/google',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({credential})});
+      if(!res.ok){log('Google sign-in verification failed','warn');return;}renderUser((await res.json()).user);
+    }});
+    const slot=document.createElement('span');auth.replaceChildren(slot);
+    window.google.accounts.id.renderButton(slot,{theme:'outline',size:'medium',text:'signin_with'});
+  }catch{auth.textContent='Google sign-in unavailable';log('GIS could not load; local demo still works','warn');}
+}
+function renderUser(user){const area=$('auth-area');const name=document.createElement('span');name.textContent=user.email||user.name||'Signed in';
+  const button=document.createElement('button');button.textContent='Sign out';button.className='subtle';button.onclick=async()=>{await fetch('/api/auth/logout',{method:'POST'});location.reload();};area.replaceChildren(name,button);
+}
+async function bootstrap() {
+  try {
+    const response=await fetch('/api/region/world');
+    if(response.ok){
+      const region=await response.json();
+      if(region.source==='OSM-derived'&&region.dataset_status==='real-source'){
+        state.world=new SimWorld(region,{source:'OSM-derived'});
+        log(`Loaded immutable OSM snapshot: ${state.world.tracks.length} track ways, ${state.world.stations.length} stops and ${state.world.routes.length} fully connected routes.`, 'ok');
+      }
+    }else if(response.status!==404)log(`OSM snapshot API HTTP ${response.status}`, 'warn');
+  }catch(e){log(`OSM snapshot unavailable: ${e.message}`, 'warn');}
+  const scenes=state.world.source==='OSM-derived'
+    ?state.world.routes.filter(r=>r.status==='connected').map(r=>({id:`osm:${r.id}`,label:`OSM visual trace · ${r.name}`}))
+    :SCENES;
+  for(const scene of scenes){const o=document.createElement('option');o.value=scene.id;o.textContent=scene.label;$('scenario-selector').append(o);}
+  $('btn-compile').addEventListener('click',compile);$('btn-play-sim').addEventListener('click',start);$('btn-stop-sim').addEventListener('click',()=>stop());
+  for(const name of ['tracks','stations','signals'])$(`layer-${name}`).addEventListener('change',layerChange);
